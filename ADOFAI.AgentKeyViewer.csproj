<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ADOFAI.AgentKeyViewer</AssemblyName>
    <RootNamespace>ADOFAI.AgentKeyViewer</RootNamespace>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ADOFAI Game Directory - Adjust this path to your game installation -->
  <PropertyGroup Condition="'$(ADOFAIPath)' == ''">
    <ADOFAIPath Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice')">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</ADOFAIPath>
    <ADOFAIPath Condition="Exists('D:\Steam\steamapps\common\A Dance of Fire and Ice')">D:\Steam\steamapps\common\A Dance of Fire and Ice</ADOFAIPath>
    <ADOFAIPath Condition="Exists('E:\Steam\steamapps\common\A Dance of Fire and Ice')">E:\Steam\steamapps\common\A Dance of Fire and Ice</ADOFAIPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ct_decomp 仅为反编译参考文件，不参与编译 -->
    <Compile Remove="ct_decomp\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity Engine References -->
    <Reference Include="UnityEngine">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 静态图片(JPG/PNG)加载：使用 .NET Framework 自带的 System.Drawing（游戏 Managed 目录内置） -->
    <Reference Include="System.Drawing" />
    <!-- .ctkv 导出/导入：ZIP 压缩包操作 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />

    <!-- Assembly-CSharp (Game Code) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityModManager -->
    <Reference Include="UnityModManager">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony (for patching) -->
    <Reference Include="0Harmony">
      <HintPath>$(ADOFAIPath)\A Dance of Fire and Ice_Data\Managed\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy to Mods folder on build -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(ADOFAIPath)' != ''">
    <MakeDir Directories="$(ADOFAIPath)\Mods\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ADOFAIPath)\Mods\$(AssemblyName)" />
    <Copy SourceFiles="Info.json" DestinationFolder="$(ADOFAIPath)\Mods\$(AssemblyName)" />
    <Copy SourceFiles="Repository.json" DestinationFolder="$(ADOFAIPath)\Mods\$(AssemblyName)" />
    <Message Importance="High" Text="Copied $(AssemblyName) to Mods folder" />
  </Target>

</Project>
